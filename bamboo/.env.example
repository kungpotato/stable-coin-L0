# bamboo relay config. Copy to relay/.env (or export) before running the relay.
# These are the WELL-KNOWN anvil dev keys — safe only for a local lab, never mainnet.

# Attester set private keys (must correspond to the addresses wired in deploy.sh ATTESTERS).
# anvil #1, #2, #3:
BAMBOO_ATTESTER_KEYS=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d,0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a,0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

# How many attester sigs the gateway requires (must match deployed threshold).
BAMBOO_THRESHOLD=2

# Relayer key that pays gas to submit receiveMessage on each chain.
# Default (anvil #0) is funded on anvil. For potato, set BAMBOO_RELAYER_KEY_POTATO to a funded key.
BAMBOO_RELAYER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# BAMBOO_RELAYER_KEY_POTATO=0x<funded on potato>

BAMBOO_POLL_MS=2000

# H-2: wait this many confirmations on the source before relaying (reorg safety).
BAMBOO_CONFIRMATIONS=2
