# Testnet settings for the remaining workshop topics (4: OApp on public testnets, 7: lzRead, 8: DevTools/multisig/Scan).
# Copy to .env and fill in:   cp .env.example .env
# .env is gitignored. Never paste these values into chat, commits or screenshots.
#
# These are REAL public testnets using LayerZero's own endpoints, DVNs and executors (not the self-hosted lab).

# --- Deployer wallet -------------------------------------------------------------------------
# A NEW wallet made only for this workshop: never one that holds mainnet funds.
# Create one with:  cast wallet new     (Foundry; prints an address and a private key)
TESTNET_PRIVATE_KEY=
# Its address (for scripts and for checking balances). Must match the key above.
TESTNET_ADDRESS=

# --- RPC endpoints ---------------------------------------------------------------------------
# From Alchemy, Infura, QuickNode or similar (free tier is enough). Public RPCs work but rate-limit.
# e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=
# e.g. https://arb-sepolia.g.alchemy.com/v2/<key>
ARBITRUM_SEPOLIA_RPC_URL=

# --- Testnet ETH -----------------------------------------------------------------------------
# Fund TESTNET_ADDRESS with at least 0.02 ETH on EACH chain (gas + LayerZero fees, which are real on testnet).
# Most faucets (Google Cloud, Alchemy) require the receiving wallet to hold >= 0.001 ETH on Ethereum MAINNET,
# which a fresh wallet does not. What worked in the workshop: Google Cloud's Sepolia faucet (Google login), then
# bridge part of it to Arbitrum Sepolia through the official Inbox on Sepolia:
#   cast send 0xaAe29B0366299461418F5324a79Afc425BE5ae21 'depositEth()' --value 0.02ether \
#     --rpc-url $SEPOLIA_RPC_URL --private-key $TESTNET_PRIVATE_KEY      (arrives on Arbitrum Sepolia in ~10-15 min)
# Check:  cast balance $TESTNET_ADDRESS --ether --rpc-url $SEPOLIA_RPC_URL

# --- Contract verification (optional, makes the contracts readable on explorers) -------------
# One Etherscan API key (V2) covers Sepolia and Arbitrum Sepolia.
ETHERSCAN_API_KEY=

# --- Filled in later by the workshop, leave empty for now ------------------------------------
# Topic 8: a Safe multisig on each testnet that will own the OApps instead of the deployer EOA.
SEPOLIA_SAFE_ADDRESS=
ARBITRUM_SEPOLIA_SAFE_ADDRESS=

# Topic 8: the Safe is 2-of-3: TESTNET_ADDRESS plus these two testnet-only owners (testnet/safe-create.sh fills them).
SAFE_OWNER_B_KEY=
SAFE_OWNER_B_ADDRESS=
SAFE_OWNER_C_KEY=
SAFE_OWNER_C_ADDRESS=
